{
  "compilerOptions": {
    "target": "ES2023",
    // tsx runs the source as-is, so imports resolve the way a bundler resolves them: `./auth0.js` and `./auth0` both work.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api", "src", "test", "vitest.config.ts"]
}
