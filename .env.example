# Copy to .env.local, or let `npm run tenant -- ... --write-env` or `npm run setup` write it for you.
# `auth0 quickstarts setup` writes a `.env` instead (the same names, minus CARTS_API_URL and POPPY_AGENTS, which default).
# Both apps read the repo-root .env and .env.local; .env.local wins. Variables already in the environment win over both.
# Both files are gitignored. Restart `npm run dev` after changing them.

# --- Your Auth0 tenant and the storefront application ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts the session cookie. Generate one: openssl rand -hex 32
AUTH0_SECRET=

# --- URLs ---
# The storefront's public URL. https in production.
APP_BASE_URL=http://localhost:3000
# The Carts API: the address the storefront calls, and the port the API listens on (PORT overrides the port).
CARTS_API_URL=http://localhost:4001
# The API's identifier in Auth0: a name, not a URL that's fetched. http://localhost:4000 is for local testing. For a
# public store, create the API with an https identifier such as https://api.<your-store>: Poppy publishes it as a
# protected resource, and the Poppy specification requires https URLs.
AUTH0_AUDIENCE=http://localhost:4000

# --- Agents ---
# Agents the API accepts (client metadata URLs, comma-separated). When this is unset the API accepts the Poppy Playground.
# Set it to an empty value to accept none.
POPPY_AGENTS=https://poppyplayground.dev/agent.json

# --- Only when you need them (`npm run tunnel` sets these for you) ---
# Your store's public host, no scheme or port, if it differs from APP_BASE_URL:
# POPPY_DOMAIN=store.example.com
# The API's public https origin. Agents sign it into every request, so it must match exactly:
# PUBLIC_ORIGIN=https://api.example.com
# Shared storage for carts, orders and Poppy Sessions (Upstash Redis). Leave unset to keep them in memory:
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=
